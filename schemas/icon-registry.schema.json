{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forma.echelonfoundry.com/schemas/icon-registry.schema.json",
  "title": "Forma icon registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "grid",
    "strokeWidth",
    "linecap",
    "linejoin",
    "icons"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "grid": {
      "const": 24
    },
    "strokeWidth": {
      "const": 1.8
    },
    "linecap": {
      "const": "round"
    },
    "linejoin": {
      "const": "round"
    },
    "icons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/icon"
      }
    }
  },
  "$defs": {
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "label",
        "keywords",
        "origin",
        "shapes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "category": {
          "enum": [
            "actions",
            "navigation",
            "status",
            "workflow",
            "diagnostics",
            "documents",
            "agents"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "origin": {
          "const": "original"
        },
        "shapes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "element",
                  "d"
                ],
                "properties": {
                  "element": {
                    "const": "path"
                  },
                  "d": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "element",
                  "cx",
                  "cy",
                  "r"
                ],
                "properties": {
                  "element": {
                    "const": "circle"
                  },
                  "cx": {
                    "type": "number"
                  },
                  "cy": {
                    "type": "number"
                  },
                  "r": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "element",
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "element": {
                    "const": "rect"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "rx": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
