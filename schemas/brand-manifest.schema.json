{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/forma-brand-manifest.schema.json",
  "title": "Forma Brand Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "identity", "themes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logo": { "type": "string", "minLength": 1 },
            "logoDark": { "type": "string", "minLength": 1 },
            "mark": { "type": "string", "minLength": 1 },
            "favicon": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "display": { "$ref": "#/$defs/fontFamily" },
            "sans": { "$ref": "#/$defs/fontFamily" },
            "mono": { "$ref": "#/$defs/fontFamily" }
          }
        },
        "radius": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "small": { "$ref": "#/$defs/dimension" },
            "medium": { "$ref": "#/$defs/dimension" },
            "pill": { "$ref": "#/$defs/dimension" }
          }
        }
      }
    },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/theme" },
        "dark": { "$ref": "#/$defs/theme" }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "shadow": {
      "type": "string",
      "description": "\"none\" or a box-shadow layer list: [inset] <x> <y> [<blur> [<spread>]] in px, then a hex or rgb(r g b / a) colour; layers separated by \", \".",
      "pattern": "^(?:none|(?:inset )?-?[0-9]+(?:\\.[0-9]+)?px(?: -?[0-9]+(?:\\.[0-9]+)?px){1,3} (?:#[0-9A-Fa-f]{6}|rgb\\([0-9]{1,3} [0-9]{1,3} [0-9]{1,3} / (?:0|1|0?\\.[0-9]+)\\))(?:, (?:inset )?-?[0-9]+(?:\\.[0-9]+)?px(?: -?[0-9]+(?:\\.[0-9]+)?px){1,3} (?:#[0-9A-Fa-f]{6}|rgb\\([0-9]{1,3} [0-9]{1,3} [0-9]{1,3} / (?:0|1|0?\\.[0-9]+)\\)))*)$"
    },
    "dimension": { "type": "string", "pattern": "^(0|[0-9]+(?:\\.[0-9]+)?(?:px|rem|em))$" },
    "fontFamily": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color"],
      "properties": {
        "elevation": {
          "type": "object",
          "additionalProperties": false,
          "description": "Elevation shadows (forma#201), compiled to --forma-elevation-1 and -2. Omitted levels default to Forma's light or dark shadows by the theme's polarity.",
          "properties": {
            "1": { "$ref": "#/$defs/shadow" },
            "2": { "$ref": "#/$defs/shadow" }
          }
        },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "surface", "accent", "border", "focus", "control"],
          "properties": {
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": ["primary", "heading", "secondary", "on-secondary-surface", "inverse"],
              "properties": {
                "primary": { "$ref": "#/$defs/hex" },
                "heading": { "$ref": "#/$defs/hex" },
                "secondary": { "$ref": "#/$defs/hex" },
                "on-secondary-surface": { "$ref": "#/$defs/hex" },
                "inverse": { "$ref": "#/$defs/hex" },
                "muted": { "$ref": "#/$defs/hex" },
                "on-chrome": { "$ref": "#/$defs/hex", "description": "Text and icons on surface.chrome (forma#201). Defaults to text.inverse; declared values must reach 4.5:1 on surface.chrome." }
              }
            },
            "surface": {
              "type": "object",
              "additionalProperties": false,
              "required": ["primary", "secondary", "inverse", "inverse-secondary"],
              "properties": {
                "primary": { "$ref": "#/$defs/hex" },
                "secondary": { "$ref": "#/$defs/hex" },
                "inverse": { "$ref": "#/$defs/hex" },
                "inverse-secondary": { "$ref": "#/$defs/hex" },
                "elevated": { "$ref": "#/$defs/hex" },
                "raised": { "$ref": "#/$defs/hex", "description": "A panel raised above the canvas (forma#201). Defaults to surface.primary moved toward white (light) or surface.secondary (dark). Declared values must give text.primary, text.heading and text.secondary 4.5:1 and the focus ring 3:1." },
                "sunken": { "$ref": "#/$defs/hex", "description": "A well below the canvas: inputs, skeletons (forma#201). Defaults to surface.secondary. Declared values must give text.primary, text.heading and text.on-secondary-surface 4.5:1; text.secondary is not a pair on it." },
                "chrome": { "$ref": "#/$defs/hex", "description": "App-bar and navigation chrome (forma#201). Defaults to surface.inverse; pairs with text.on-chrome." }
              }
            },
            "accent": {
              "type": "object",
              "additionalProperties": false,
              "required": ["primary", "secondary"],
              "properties": {
                "primary": { "$ref": "#/$defs/hex" },
                "secondary": { "$ref": "#/$defs/hex" },
                "hover": { "$ref": "#/$defs/hex" }
              }
            },
            "status": {
              "type": "object",
              "additionalProperties": false,
              "description": "Optional brand overrides for public status roles. Omitted roles inherit from the active core theme; declared values must reach 4.5:1 on the primary surface and accompany a non-color cue.",
              "properties": {
                "success": { "$ref": "#/$defs/hex" },
                "warning": { "$ref": "#/$defs/hex" },
                "danger": { "$ref": "#/$defs/hex" },
                "info": { "$ref": "#/$defs/hex" }
              }
            },
            "border": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subtle", "functional"],
              "properties": {
                "subtle": { "$ref": "#/$defs/hex" },
                "functional": { "$ref": "#/$defs/hex" }
              }
            },
            "focus": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ring", "gap"],
              "properties": {
                "ring": { "$ref": "#/$defs/hex" },
                "gap": { "$ref": "#/$defs/hex" }
              }
            },
            "control": {
              "type": "object",
              "additionalProperties": false,
              "required": ["track", "thumb", "active"],
              "properties": {
                "track": { "$ref": "#/$defs/hex" },
                "thumb": { "$ref": "#/$defs/hex" },
                "active": { "$ref": "#/$defs/hex" }
              }
            }
          }
        }
      }
    }
  }
}
