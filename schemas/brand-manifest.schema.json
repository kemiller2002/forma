{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/forma-brand-manifest.schema.json",
  "title": "Forma Brand Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "identity", "themes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logo": { "type": "string", "minLength": 1 },
            "logoDark": { "type": "string", "minLength": 1 },
            "mark": { "type": "string", "minLength": 1 },
            "favicon": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "display": { "$ref": "#/$defs/fontFamily" },
            "sans": { "$ref": "#/$defs/fontFamily" },
            "mono": { "$ref": "#/$defs/fontFamily" }
          }
        },
        "radius": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "small": { "$ref": "#/$defs/dimension" },
            "medium": { "$ref": "#/$defs/dimension" },
            "pill": { "$ref": "#/$defs/dimension" }
          }
        }
      }
    },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/theme" },
        "dark": { "$ref": "#/$defs/theme" }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "dimension": { "type": "string", "pattern": "^(0|[0-9]+(?:\\.[0-9]+)?(?:px|rem|em))$" },
    "fontFamily": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color"],
      "properties": {
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "surface", "accent", "border", "focus", "control"],
          "properties": {
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": ["primary", "heading", "secondary", "on-secondary-surface", "inverse"],
              "properties": {
                "primary": { "$ref": "#/$defs/hex" },
                "heading": { "$ref": "#/$defs/hex" },
                "secondary": { "$ref": "#/$defs/hex" },
                "on-secondary-surface": { "$ref": "#/$defs/hex" },
                "inverse": { "$ref": "#/$defs/hex" },
                "muted": { "$ref": "#/$defs/hex" }
              }
            },
            "surface": {
              "type": "object",
              "additionalProperties": false,
              "required": ["primary", "secondary", "inverse", "inverse-secondary"],
              "properties": {
                "primary": { "$ref": "#/$defs/hex" },
                "secondary": { "$ref": "#/$defs/hex" },
                "inverse": { "$ref": "#/$defs/hex" },
                "inverse-secondary": { "$ref": "#/$defs/hex" },
                "elevated": { "$ref": "#/$defs/hex" }
              }
            },
            "accent": {
              "type": "object",
              "additionalProperties": false,
              "required": ["primary", "secondary"],
              "properties": {
                "primary": { "$ref": "#/$defs/hex" },
                "secondary": { "$ref": "#/$defs/hex" },
                "hover": { "$ref": "#/$defs/hex" }
              }
            },
            "status": {
              "type": "object",
              "additionalProperties": false,
              "description": "Optional marketing status roles; each must reach 4.5:1 on the primary surface and always accompany text.",
              "properties": {
                "success": { "$ref": "#/$defs/hex" },
                "warning": { "$ref": "#/$defs/hex" },
                "danger": { "$ref": "#/$defs/hex" },
                "info": { "$ref": "#/$defs/hex" }
              }
            },
            "border": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subtle", "functional"],
              "properties": {
                "subtle": { "$ref": "#/$defs/hex" },
                "functional": { "$ref": "#/$defs/hex" }
              }
            },
            "focus": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ring", "gap"],
              "properties": {
                "ring": { "$ref": "#/$defs/hex" },
                "gap": { "$ref": "#/$defs/hex" }
              }
            },
            "control": {
              "type": "object",
              "additionalProperties": false,
              "required": ["track", "thumb", "active"],
              "properties": {
                "track": { "$ref": "#/$defs/hex" },
                "thumb": { "$ref": "#/$defs/hex" },
                "active": { "$ref": "#/$defs/hex" }
              }
            }
          }
        }
      }
    }
  }
}
