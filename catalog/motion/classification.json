{
  "schemaVersion": 1,
  "description": "Maps every shipped animated selector/property (a 'track') to one of the five canonical motion models in models.json (MOT-010, MOT-028). Classification records the phenomenon each track represents; whether its timing already uses that model's variables is checked separately by the audit. reducedMotion.strategy is one of: explicit (a prefers-reduced-motion: reduce rule names the selector), scope-tokens (the component scope collapses its model variables under reduced motion), global (a stylesheet-wide reduced-motion rule removes transitions/animations), stop (a reduce rule stops the repeated or sequenced animation), brief (non-spatial perceptual change only; a brief transition may remain), preserve (direct manipulation keeps its direct mapping).",
  "entries": [
    { "source": "src/styles/components.css", "family": "switch", "selector": ".ef-switch__track",
      "tracks": { "background": "perceptual", "border-color": "perceptual" },
      "reducedMotion": { "strategy": "brief" } },
    { "source": "src/styles/components.css", "family": "switch", "selector": ".ef-switch__track::after",
      "tracks": { "translate": "inertial", "scale": "inertial", "border-color": "perceptual" },
      "reducedMotion": { "strategy": "explicit" } },
    { "source": "src/styles/components.css", "family": "checkbox", "selector": ".ef-checkbox__box",
      "tracks": { "background": "perceptual", "border-color": "perceptual", "scale": "inertial" },
      "reducedMotion": { "strategy": "scope-tokens", "scope": ".ef-checkbox" } },
    { "source": "src/styles/components.css", "family": "checkbox", "selector": ".ef-checkbox__box::after",
      "tracks": { "opacity": "perceptual", "rotate": "inertial", "scale": "inertial" },
      "reducedMotion": { "strategy": "scope-tokens", "scope": ".ef-checkbox" } },
    { "source": "src/styles/components.css", "family": "select", "selector": ".ef-select__input",
      "tracks": { "background": "perceptual", "border-color": "perceptual" },
      "reducedMotion": { "strategy": "brief" } },
    { "source": "src/styles/components.css", "family": "select", "selector": ".ef-select__indicator",
      "tracks": { "rotate": "inertial", "translate": "gravity" },
      "reducedMotion": { "strategy": "explicit" } },
    { "source": "src/styles/components.css", "family": "slider", "selector": ".ef-slider__input",
      "tracks": { "filter": "perceptual", "opacity": "perceptual" },
      "reducedMotion": { "strategy": "brief" },
      "note": "The native range value is direct manipulation owned by the browser; only hover/active emphasis is transitioned." },
    { "source": "src/styles/components.css", "family": "segmented", "selector": ".ef-segment",
      "tracks": { "background": "perceptual", "color": "perceptual", "transform": "inertial" },
      "reducedMotion": { "strategy": "explicit" } },
    { "source": "src/styles/components.css", "family": "disclosure", "selector": ".ef-disclosure > summary::after",
      "tracks": { "rotate": "inertial", "scale": "inertial" },
      "reducedMotion": { "strategy": "explicit" } },
    { "source": "src/styles/components.css", "family": "disclosure", "selector": ".ef-disclosure__content",
      "tracks": { "opacity": "perceptual", "translate": "inertial" },
      "entrySelectors": [".ef-disclosure[open] .ef-disclosure__content"],
      "reducedMotion": { "strategy": "explicit" } },
    { "source": "src/styles/components.css", "family": "popover-menu", "selector": ".ef-popover, .ef-menu",
      "tracks": { "opacity": "perceptual", "translate": "inertial", "scale": "inertial" },
