      "reducedMotion": { "strategy": "explicit" } },
    { "source": "src/styles/components.css", "family": "modal-backdrop", "selector": ":where(.ef-dialog, .ef-flyout)::backdrop",
      "tracks": { "background": "perceptual", "backdrop-filter": "perceptual" },
