    { "source": "src/styles/components.css", "family": "fault-notification", "selector": ".ef-fault-notification[data-ef-motion-entry]",
      "tracks": { "opacity": "perceptual", "translate": "inertial" },
      "reducedMotion": { "strategy": "scope-tokens", "scope": ".ef-fault-notification" } },
    { "source": "src/styles/components.css", "family": "fault-banner", "selector": ".ef-fault-banner[data-ef-motion-entry]",
      "tracks": { "opacity": "perceptual", "translate": "inertial" },
      "reducedMotion": { "strategy": "scope-tokens", "scope": ".ef-fault-banner" } },
    { "source": "src/styles/components.css", "family": "character-grid-reveal",
      "selector": ".ef-character-grid[data-ef-reveal=\"sequential\"] :is(.ef-character-grid__surface, .ef-character-grid__group) > .ef-character-grid__text[data-ef-reveal-run]",
      "tracks": { "animation:ef-character-grid-reveal": "cadence" },
      "reducedMotion": { "strategy": "stop" },
      "approvedLiterals": [{ "value": "1ms", "reason": "Unit coercion: CharacterGrid cadence parameters are unitless millisecond counts (requirements/CHARACTER-GRID.md, SequentialReveal)." }],
      "note": "SequentialReveal is a bounded discrete cadence (row/column sequencing), not inertial motion. Reveal completion never gates semantics." },
    { "source": "src/styles/components.css", "family": "character-grid-reveal",
      "selector": ".ef-character-grid[data-ef-reveal=\"sequential\"] :is(.ef-character-grid__surface, .ef-character-grid__group) > .ef-character-grid__text[data-ef-reveal-run]:dir(rtl)",
      "tracks": { "animation:ef-character-grid-reveal-rtl": "cadence" },
      "reducedMotion": {
        "strategy": "stop",
        "selector": ".ef-character-grid[data-ef-reveal=\"sequential\"] :is(.ef-character-grid__surface, .ef-character-grid__group) > .ef-character-grid__text[data-ef-reveal-run]"
      },
      "note": "Right-to-left variant; the base selector's reduced-motion rule also matches these runs." },
    { "source": "src/styles/assessment.css", "family": "ordinal-option", "selector": ".ef-ordinal-option",
      "tracks": { "background": "perceptual", "color": "perceptual", "transform": "inertial" },
      "reducedMotion": { "strategy": "explicit" } },
    { "source": "src/styles/assessment.css", "family": "choice", "selector": ".ef-choice",
      "tracks": { "background": "perceptual", "border-color": "perceptual" },
      "reducedMotion": { "strategy": "brief" } },
    { "source": "src/marketing/components.css", "family": "marketing-button", "selector": ".ef-site .ef-button",
      "tracks": { "background-color": "perceptual", "color": "perceptual", "transform": "inertial" },
      "reducedMotion": { "strategy": "global" } },
    { "source": "src/marketing/components.css", "family": "marketing-card", "selector": ".ef-card:has(.ef-card__link)",
      "tracks": { "background-color": "perceptual" },
      "reducedMotion": { "strategy": "brief" } },
    { "source": "site/site.css", "family": "site-button", "selector": ".ef-button",
      "tracks": { "background": "perceptual", "color": "perceptual", "transform": "inertial" },
      "reducedMotion": { "strategy": "global" } }
  ]
