{
  "schemaVersion": 1,
  "description": "Maps every shipped animated selector/property (a 'track') to one of the five canonical motion models in models.json (MOT-010, MOT-028). Classification records the phenomenon each track represents; whether its timing already uses that model's variables is checked separately by the audit. reducedMotion.strategy is one of: explicit (a prefers-reduced-motion: reduce rule names the selector), scope-tokens (the component scope collapses its model variables under reduced motion), global (a stylesheet-wide reduced-motion rule removes transitions/animations), stop (a reduce rule stops the repeated or sequenced animation), brief (non-spatial perceptual change only; a brief transition may remain), preserve (direct manipulation keeps its direct mapping).",
  "entries": [
    {
      "source": "src/styles/foundations.css",
      "family": "button",
      "selector": ":where(button, .ef-button)",
      "tracks": {
        "background-color": "perceptual",
        "border-color": "perceptual"
      },
      "reducedMotion": {
        "strategy": "brief"
      },
      "note": "Hover/press feedback is non-spatial; press onset uses the direct (0ms) response so activation is never delayed."
    },
    {
      "source": "src/styles/components.css",
      "family": "switch",
      "selector": ".ef-switch__track",
      "tracks": {
        "background": "perceptual",
        "border-color": "perceptual"
      },
      "reducedMotion": {
        "strategy": "brief"
      }
    },
    {
      "source": "src/styles/components.css",
      "family": "switch",
      "selector": ".ef-switch__track::after",
      "tracks": {
        "translate": "inertial",
        "scale": "inertial",
        "border-color": "perceptual"
      },
      "reducedMotion": {
        "strategy": "explicit"
      }
    },
    {
      "source": "src/styles/components.css",
