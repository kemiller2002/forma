{
  "name": "@echelon-foundry/design-system",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Zero-runtime HTML and CSS design system for Echelon Foundry applications.",
  "sideEffects": [
    "./dist/*.css",
    "./dist/brands/*.css",
    "./dist/marketing.css",
    "./dist/marketing/*.css"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./foundations.css": "./dist/foundations.css",
    "./components.css": "./dist/components.css",
    "./all.css": "./dist/all.css",
    "./patterns/*": "./dist/patterns/*",
    "./assessment.css": "./dist/assessment.css",
    "./skins.css": "./dist/skins.css",
    "./brands/*": "./dist/brands/*",
    "./brand-manifest.schema.json": "./schemas/brand-manifest.schema.json",
    "./marketing.css": "./dist/marketing.css",
    "./marketing/*": "./dist/marketing/*",
    "./tokens.json": "./tokens/echelon.tokens.json",
    "./figma/components.json": "./figma/component-contracts.json",
    "./contracts/diagram-presentation.json": "./contracts/diagram-presentation.json",
    "./workflow/forma-workflow.schema.json": "./schemas/workflow/1.0/forma-workflow.schema.json",
    "./contracts/workflow-capabilities.json": "./contracts/workflow-capabilities.json",
    "./workflow/examples/*": "./examples/workflows/forma/workflows/*",
    "./contracts/machine-operability.json": "./contracts/machine-operability.json"
  },
  "files": [
    "dist",
    "patterns",
    "schemas/brand-manifest.schema.json",
    "docs/BRANDING.md",
    "docs/MARKETING-SITES.md",
    "tokens/echelon.tokens.json",
    "figma/component-contracts.json",
    "contracts/diagram-presentation.json",
    "schemas/workflow/1.0/forma-workflow.schema.json",
    "contracts/workflow-capabilities.json",
    "examples/workflows/forma/workflows",
    "examples/workflows/fixtures.json",
    "docs/workflow",
    "contracts/machine-operability.json"
  ],
  "scripts": {
    "clean": "node tools/clean.mjs",
    "tokens:build": "dotnet run --project tools/TokenCompiler/TokenCompiler.fsproj -- tokens/echelon.tokens.json dist/tokens.css",
    "assets:build": "node tools/build-assets.mjs",
    "build": "npm run clean && npm run tokens:build && npm run brands:build && npm run marketing:theme && npm run assets:build && npm run marketing:build && npm run example:install",
    "test:tokens": "node --test tests/token-compiler.test.mjs",
    "test:browser": "playwright test",
    "test:a11y": "playwright test tests/browser/accessibility.spec.mjs",
    "test:runtime": "node --test tests/zero-runtime.test.mjs",
    "motion:audit": "node tools/motion-audit.mjs",
    "test:motion": "node --test tests/motion-audit.test.mjs tests/motion-gate.test.mjs && node tools/motion-audit.mjs --strict",
    "check": "npm run build && npm run test:tokens && npm run test:brands && npm run test:runtime && npm run test:motion && npm run test:marketing && npm run test:character-grid && npm run test:figma && npm run test:css && npm run test:package && npm run workflow:test && npm run workflow:build && npm run test:workflow-package && npm run test:browser",
    "site:build": "npm run build && node tools/build-site.mjs",
    "site:test": "node --test tests/site-build.test.mjs tests/catalog-coverage.test.mjs",
    "site:check": "npm run site:build && npm run catalog:check && npm run site:test && npm run site:mobile",
    "site:mobile": "playwright test --config=playwright.site.config.mjs",
    "pack:verify": "npm run build && npm pack --dry-run",
    "test:package": "node --test tests/package-contract.test.mjs",
    "test:css": "node --test tests/css-source.test.mjs tests/diagram-contract.test.mjs",
    "brands:build": "dotnet run --project tools/BrandCompiler/BrandCompiler.fsproj -- brands dist/brands",
    "test:brands": "node --test tests/brand-compiler.test.mjs",
    "test:character-grid": "node --test tests/character-grid.test.mjs",
    "marketing:theme": "dotnet run --project tools/TokenCompiler/TokenCompiler.fsproj -- themes/echelon/marketing.tokens.json build/marketing/echelon-marketing.tokens.css --reference tokens/echelon.tokens.json",
    "marketing:build": "dotnet run --project tools/PresentationBundler/PresentationBundler.fsproj -- bundles/echelon-marketing.bundle.json package.json",
    "test:marketing": "node --test tests/marketing-tokens.test.mjs tests/marketing-distribution.test.mjs tests/marketing-structure.test.mjs tests/site-css-policy.test.mjs",
    "example:install": "mkdir -p build/example && cp examples/echelon-marketing-site/forma.lock build/example/forma.lock && bash actions/install-presentation/install.sh --lock build/example/forma.lock --source dist/marketing --update --output examples/echelon-marketing-site/assets/forma",
    "policy:check": "dotnet run --project tools/SiteCssPolicy/SiteCssPolicy.fsproj --",
    "release:check": "npm run build && npm run test:tokens && npm run test:brands && npm run test:runtime && npm run test:motion && npm run test:marketing && npm run test:character-grid && npm run test:css && npm run test:package && npm run test:machine:audit && npm run test:machine && playwright test tests/browser/marketing.spec.mjs && npm run site:check",
    "test:figma": "node --test tests/figma-contract.test.mjs",
    "catalog:check": "node tools/catalog/validate.mjs && node tools/machine-operability-audit.mjs --check && node tools/catalog/inventory.mjs --check",
    "catalog:inventory": "node tools/catalog/inventory.mjs",
    "workflow:test": "dotnet run --project tests/workflow/Forma.Workflow.Tests -c Release",
    "workflow:build": "node tools/build-workflow-package.mjs",
    "workflow:validate": "dotnet run --project src/workflow/Forma.Workflow.Cli -c Release -- validate examples/workflows/forma/workflows/*.forma-workflow.json",
    "test:workflow-package": "node --test tests/workflow-package.test.mjs",
    "test:workflow-browser": "playwright test tests/browser/workflow-static.spec.mjs tests/browser/workflow-embed.spec.mjs",
    "workflow:check": "npm run workflow:test && npm run workflow:build && npm run test:workflow-package && npm run test:workflow-browser",
    "test:machine": "playwright test tests/browser/machine-operability.spec.mjs",
    "machine:audit": "node tools/machine-operability-audit.mjs --write",
    "machine:audit:check": "node tools/machine-operability-audit.mjs --check",
    "test:machine:audit": "node --test tests/machine-operability-audit.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemiller2002/forma.git"
  },
  "homepage": "https://forma.echelonfoundry.com/",
  "keywords": [
    "design-system",
    "zero-runtime",
    "marketing-presentation",
    "accessibility",
    "workflow",
    "machine-operability"
  ]
}
