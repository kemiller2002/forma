{
  "format": "forma.design",
  "schemaVersion": "1.0.0",
  "id": "invalid-parent-child",
  "mode": "standard",
  "compatibility": { "forma": ">=0.8.0 <1.0.0" },
  "responsive": { "strategy": "container", "narrow": "stack", "minimumViewportCssPx": 320 },
  "motion": { "profile": "none", "reducedMotion": "preserve-state" },
  "root": {
    "kind": "form",
    "id": "parent-form",
    "title": "Parent form",
    "method": "get",
    "action": "#saved",
    "children": [
      {
        "kind": "layout",
        "id": "fields",
        "model": "grid",
        "alignControls": true,
        "overflow": "wrap",
        "children": [
          { "kind": "action", "id": "save-in-fields", "label": "Save", "type": "submit", "binding": "form.submit" }
        ]
      },
      {
        "kind": "actions",
        "id": "actions",
        "children": [
          { "kind": "action", "id": "save", "label": "Save", "type": "submit", "binding": "form.submit" }
        ]
      },
      { "kind": "feedback", "id": "saved", "label": "Save status", "message": "Saved." }
    ]
  }
}
