{
  "schemaVersion": "1.0.0",
  "contract": "forma.diagram-presentation",
  "contractVersion": "2.1.0",
  "stylesheet": "components.css",
  "decision": "docs/decisions/ADR-0004-diagram-presentation-boundary.md",
  "requirements": "requirements/OBJECT-METADATA-AND-DIAGRAM-PRESENTATION.md",
  "ownership": {
    "forma": ["surface", "node", "group", "connector", "connectorLabel", "marker", "relations", "legend", "valueState", "port", "status", "description", "membership"],
    "consumer": ["geometry", "routing", "semanticKind", "metadataValues", "metadataVisibility", "namedStyles", "paletteSlots", "metadataMappings", "appearancePrecedence", "membership", "portPlacement", "statusValues"],
    "editorOnly": ["selection", "handles", "guides", "routePreview", "marquee", "dragTargets", "connectionTargets", "minimap", "validationOverlay"],
    "editorOnlyRule": "Editor-only adorners never use forma-diagram* classes and never appear in exported output."
  },
  "elements": {
    "surface": { "element": "figure", "class": "forma-diagram", "parts": { "viewport": "forma-diagram__viewport", "canvas": "forma-diagram__canvas", "wires": "forma-diagram__wires" } },
    "node": {
      "element": "article",
      "class": "forma-diagram-node",
      "regions": { "kind": "forma-diagram-node__kind", "label": "forma-diagram-node__label", "description": "forma-diagram-node__description", "metadata": "forma-diagram-node__meta" },
      "statusAttribute": "data-forma-status",
      "statusCues": { "active": "outer ring", "blocked": "double border", "failed": "double border", "skipped": "dashed border", "cancelled": "dashed border", "pending": "dotted border", "waiting": "dotted border" },
      "statusRule": "Status is text in the node metadata (dt Status, dd label). data-forma-status selects only a secondary non-colour cue; other values render no cue.",
      "shapeAttribute": "data-forma-shape",
      "shapes": ["rectangle", "rounded", "pill", "ellipse", "diamond"],
      "defaultShape": "rectangle",
      "shapeNotes": { "diamond": "Square box (aspect-ratio 1); content sits in the inscribed square, so give it enough width for the label." },
      "geometry": ["x", "y", "w", "h"],
      "appearance": ["fill", "stroke", "accent", "foreground"]
    },
    "group": {
      "element": "div",
      "class": "forma-diagram-group",
      "regions": { "header": "forma-diagram-group__header", "kind": "forma-diagram-group__kind", "label": "forma-diagram-group__label" },
      "variantAttribute": "data-forma-group",
      "variants": ["group", "lane", "phase"],
      "defaultVariant": "group",
      "lineAttribute": "data-forma-line",
      "lineStyles": ["solid", "dashed", "dotted"],
      "geometry": ["x", "y", "w", "h"],
      "appearance": ["fill", "stroke", "accent", "foreground"],
      "paintOrder": "Place groups first in the canvas so they paint beneath connectors and nodes.",
      "membership": "Consumer data. Canvas overlap never implies membership."
    },
    "connector": {
      "element": "path",
      "class": "forma-diagram-connector",
      "lineAttribute": "data-forma-line",
      "lineStyles": ["solid", "dashed", "dotted"],
      "defaultLineStyle": "solid",
      "markers": { "class": "forma-diagram-marker", "kinds": ["arrow"], "attachment": ["marker-start", "marker-end"] },
      "appearance": ["connectorStroke", "connectorWidth"]
    },
    "port": { "element": "span", "class": "forma-diagram-port", "parent": "forma-diagram-node", "label": "forma-diagram-port__label", "sideAttribute": "data-forma-side", "sides": ["top", "right", "bottom", "left"], "directionAttribute": "data-forma-direction", "directions": ["in", "out", "inout"], "directionCue": "in: square, out: circle, inout: diamond", "offset": "--forma-diagram-port-offset", "rule": "A port is a marker. The relationship list names the port in text when a connector uses it." },
    "membership": { "element": "dl", "class": "forma-diagram__membership", "rule": "One dt per group, lane or phase; its dd lists members in reading order. Canvas overlap never implies membership." },
    "connectorLabel": { "element": "span", "class": "forma-diagram-connector__label", "geometry": ["x", "y"] },
    "relations": { "element": "ol", "class": "forma-diagram__relations", "rule": "One text item per connector, in reading order." },
    "legend": { "element": "dl", "class": "forma-diagram-legend", "swatch": "forma-diagram-legend__swatch", "appearance": ["fill", "stroke", "accent"] },
    "valueState": {
      "element": "span",
      "class": "forma-diagram-value-state",
      "stateAttribute": "data-forma-value-state",
      "states": ["default", "derived", "source-bound", "unknown", "unavailable", "invalid"],
      "explicit": "Explicit values carry no tag.",
      "rule": "The tag text carries the meaning; the border style is secondary."
    }
  },
  "appearanceProperties": {
    "fill": { "customProperty": "--forma-diagram-fill", "appliesTo": ["node", "group", "legend"], "syntax": "color", "default": { "node": "--forma-color-surface-primary", "group": "transparent", "legend": "--forma-color-surface-primary" }, "contrast": "consumer" },
    "stroke": { "customProperty": "--forma-diagram-stroke", "appliesTo": ["node", "group", "legend"], "syntax": "color", "default": { "node": "--forma-color-border-functional", "group": "--forma-color-border-functional", "legend": "--forma-color-border-functional" }, "print": "Authored stroke prints; otherwise black.", "contrast": "consumer" },
    "accent": { "customProperty": "--forma-diagram-accent", "appliesTo": ["node", "group", "legend"], "syntax": "color", "default": { "node": "stroke", "group": "stroke", "legend": "stroke" }, "contrast": "consumer" },
    "foreground": { "customProperty": "--forma-diagram-foreground", "appliesTo": ["node", "group"], "syntax": "color", "default": { "node": "--forma-color-text-primary", "group": "--forma-color-text-primary" }, "contrast": "consumer" },
    "connectorStroke": { "customProperty": "--forma-diagram-connector-stroke", "appliesTo": ["connector"], "syntax": "color", "default": { "connector": "--forma-color-border-functional" }, "contrast": "consumer" },
    "connectorWidth": { "customProperty": "--forma-diagram-connector-width", "appliesTo": ["connector"], "syntax": "number", "range": [1, 8], "default": { "connector": "2" } }
  },
  "geometryProperties": {
    "x": "--forma-diagram-x",
    "y": "--forma-diagram-y",
    "w": "--forma-diagram-w",
    "h": "--forma-diagram-h",
    "canvasWidth": "--forma-diagram-canvas-w",
    "canvasHeight": "--forma-diagram-canvas-h",
    "portOffset": "--forma-diagram-port-offset",
    "unit": "px",
    "unitNote": "Any CSS length is accepted. Forma.Workflow emits rem (1rem = 16 canvas px), so diagram geometry scales with enlarged text (LCE-001).",
    "axes": "physical (does not mirror in right-to-left documents)"
  },
  "color": {
    "paint": "solid",
    "literalSyntax": "#rrggbb",
    "literalNote": "Consumers normalize literals to lowercase six-digit hex; alpha, gradients, blend modes and filters are not part of this contract (FMD-PAINT-001..003).",
    "tokenReferences": [
      "--forma-color-accent-primary",
      "--forma-color-accent-secondary",
      "--forma-color-border-functional",
      "--forma-color-border-subtle",
      "--forma-color-surface-primary",
      "--forma-color-surface-secondary",
      "--forma-color-surface-inverse",
      "--forma-color-text-primary",
      "--forma-color-text-secondary",
      "--forma-color-status-warning",
      "--forma-color-status-danger",
      "--forma-color-status-success",
      "--forma-color-status-info"
    ],
    "reset": "Remove the custom property to restore the Forma default (FMD-RESOLVE-006)."
  },
  "fallbacks": {
    "forcedColors": "Nodes, groups, swatches and labels use Canvas/CanvasText; connectors and markers use CanvasText. Kind text, shape, line style and value-state text remain.",
    "print": "Viewport stops scrolling; nodes avoid page breaks; authored strokes and accents print; unauthored boundaries print black.",
    "backgroundsDisabled": "Every shape and group has a real border, so boundaries survive when fills are dropped.",
    "grayscale": "Meaning is carried by kind text, labels, line style, the relationship list and the legend text, never by hue."
  }
}
