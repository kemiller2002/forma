# Operating-system files
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# Generated transient work
.ros/locks/
work/staging/*
work/review/*
logs/*

# Preserve directory markers and documentation
!work/staging/.gitkeep
!work/review/.gitkeep
!logs/.gitkeep

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# BEGIN echelon:visual-engineering
# Installed Visual Engineering context. Refresh it with:
#   npx @echelon-foundry/visual-engineering init
.visual-engineering/
# END echelon:visual-engineering

# Generated build output
dist/
site-dist/

# F# tool build output (never tracked: stale binaries can be mistaken for up to date)
tools/**/bin/
tools/**/obj/
build/

# Reference example installs Forma assets as a consumer would
examples/*/assets/forma/

# Playwright run output
test-results/

# Workflow F# build output
src/workflow/**/bin/
src/workflow/**/obj/
tests/workflow/**/bin/
tests/workflow/**/obj/
packages/workflow/dist/
